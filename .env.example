# Copy to .env and fill in before `docker compose up`.
# Generate any secret below with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── Required in production ────────────────────────────────────────
# Signs login tokens. The app refuses to start in production without it
# (or with fewer than 32 characters). Changing it signs everyone out.
JWT_SECRET=

# Password for the bundled PostgreSQL container (docker-compose.yml).
POSTGRES_PASSWORD=

# Operator key for the admin console (/admin.html) and plan activation.
# Leave empty to disable the console entirely. At least 16 characters.
ADMIN_KEY=

# Public domain for the optional HTTPS proxy (`docker compose --profile https up`).
# DOMAIN=app.yourdomain.com

# ── AI Copilot (optional) ─────────────────────────────────────────
# Unset → the copilot answers "not configured"; everything else works.
# DEEPSEEK_API_KEY=
# AGENT_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=deepseek-chat

# ── Runtime ───────────────────────────────────────────────────────
# "production" turns on the startup safety checks and HSTS. docker-compose
# sets it for you; leave unset for local development.
# APP_ENV=production

# Database. Unset → local SQLite (data/kol_saas.db, or $SQLITE_DIR in Docker).
# Compose sets this to the bundled PostgreSQL automatically.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/kol_saas

# Only needed when a frontend on a DIFFERENT origin calls the API. The bundled
# frontend is same-origin, so leave this unset. "*" is rejected in production.
# CORS_ORIGINS=https://app.yourdomain.com

# uvicorn worker processes (≈ CPU cores; the optimizer is CPU-bound).
# WEB_CONCURRENCY=4

# SQLAlchemy pool per worker: total DB connections = workers × (size + overflow).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Largest accepted upload / request body, in MB.
# MAX_UPLOAD_MB=10

# LOG_LEVEL=INFO

# ── Local development only (production refuses to boot with these) ─
# Lets a merchant switch to a paid plan without paying — for demos.
# BILLING_SELF_SERVE=1
